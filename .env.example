# Server-side only. Used by the Netlify Functions; never sent to the browser.
# Optional override; the functions fall back to the key in netlify/functions/_civic.mjs.
GOOGLE_CIVIC_API_KEY=

# Optional. Browser key for Maps JavaScript API + Places Autocomplete.
# Restrict it by HTTP referrer in Google Cloud Console. If unset, the app
# falls back to an OpenStreetMap map and a plain address field.
GOOGLE_MAPS_BROWSER_KEY=
